# Copy to .env for local development. Never commit real values.
# In production, set these as Railway service variables.

# Port (Railway sets this automatically)
PORT=3000

# Where sessions and sync status are stored. On Railway, mount a volume here.
DATA_DIR=./data

# Airtable
AIRTABLE_BASE_ID=
AIRTABLE_READ_KEY=
AIRTABLE_WRITE_KEY=

# Aufzugshandwerk ERP. Per-company keys win over the global fallback.
AUFZUG_BASE_URL=https://verwaltung.api.aufzugshandwerk.de/v1
AUFZUG_API_KEY=
AUFZUG_API_KEY_AUFZUG=
AUFZUG_API_KEY_ASZENDIO=

# Freshdesk, one set per company slug (FRESHDESK_DOMAIN_<SLUG> is the subdomain only)
FRESHDESK_DOMAIN_AUFZUG=
FRESHDESK_API_KEY_AUFZUG=
FRESHDESK_DOMAIN_ASZENDIO=
FRESHDESK_API_KEY_ASZENDIO=

# Order Display (LiteLead MCP). Per-company account key wins over the global one.
ORDERDISPLAY_MCP_URL=https://mcp2.litelead.xyz/mcp
ORDERDISPLAY_TOKEN=
ORDERDISPLAY_ACCOUNT_KEY=
ORDERDISPLAY_ACCOUNT_KEY_AUFZUG=
ORDERDISPLAY_ACCOUNT_KEY_ASZENDIO=

# Mailchimp fallback, only used when the company has no key/audience in Airtable "Firmen"
MAILCHIMP_API_KEY_AUFZUG=
MAILCHIMP_AUDIENCE_AUFZUG=
MAILCHIMP_API_KEY_ASZENDIO=
MAILCHIMP_AUDIENCE_ASZENDIO=

# Liftaro partner API. LIFTARO_PARTNER_KEY_<SLUG> wins (chosen via X-Firma-Slug header).
LIFTARO_BASE_URL=https://giltglobalinvest--4c42aaf257b611f19fa0ee650bb23af1.web.val.run/api/v2
LIFTARO_PARTNER_KEY=
LIFTARO_PARTNER_KEY_AUFZUG=
LIFTARO_PARTNER_KEY_ASZENDIO=

# Shared secret for cron calls to /sync/run-all (X-Sync-Secret header)
SYNC_SECRET=
# Optional in-process schedule for /sync/run-all, e.g. */30 * * * *  (empty = off)
SYNC_CRON=
SYNC_CRON_TZ=UTC
